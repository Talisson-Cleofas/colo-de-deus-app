# Ambiente real / produção. Não use DEMO_MODE=true em produção.
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:5173
DEMO_MODE=false
DATABASE_PROVIDER=google-sheets
TRUST_PROXY=false
SWAGGER_ENABLED=true

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Sheets
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_STRUCTURE_CACHE_SECONDS=300
GOOGLE_SHEETS_DATA_CACHE_SECONDS=45
GOOGLE_SHEETS_STALE_CACHE_SECONDS=900
GOOGLE_SHEETS_RETRY_ATTEMPTS=6

# Proteção de requisições
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Lectio Divina
LECTIO_CNBB_URL=https://www.cnbb.org.br/liturgia-diaria/
LECTIO_CNBB_MIRROR_URL=https://cnbbsul3.org.br/liturgia-diaria/
LECTIO_CANCAO_NOVA_URL=https://liturgia.cancaonova.com/pb/
LECTIO_PROVIDER_TIMEOUT_MS=20000
LECTIO_PROVIDER_CACHE_TTL_MS=900000
LECTIO_AUTO_SYNC_ENABLED=true
LECTIO_AUTO_SYNC_TIMEZONE=America/Sao_Paulo
LECTIO_AUTO_SYNC_HOUR=0
LECTIO_AUTO_SYNC_MINUTE=10
LECTIO_AUTO_SYNC_RETRY_MINUTES=30

# Google Drive e Maps
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_GEOCODING_ENABLED=false
GOOGLE_MAPS_CACHE_TTL_HOURS=24

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ALLOW_UNSIGNED_WEBHOOKS=false
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=900
MERCADO_PAGO_WEBHOOK_MAX_ATTEMPTS=5
MERCADO_PAGO_API_TIMEOUT_MS=10000
MERCADO_PAGO_ENVIRONMENT=production
PUBLIC_API_URL=https://sua-api.onrender.com
FRONTEND_URL=https://seu-app.netlify.app

# Soma+
SOMA_MONTHLY_GOAL=50000
SOMA_PIX_KEY=
SOMA_PIX_KEY_TYPE=E-mail
SOMA_BENEFICIARY=Colo de Deus - Missão Brasília
SOMA_CITY=Brasília
SOMA_PIX_BANK=
SOMA_PIX_AGENCY=
SOMA_PIX_ACCOUNT=
SOMA_PIX_CNPJ=
# Legado: o app não usa mais link estático para novas assinaturas.
SOMA_SUBSCRIPTION_URL=
SOMA_PIX_QR_CODE_URL=/assets/mercado-pago-pix-qr.png
